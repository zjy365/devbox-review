# OpenAI / Pi
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENREVIEW_MODEL_PROVIDER=openai
OPENREVIEW_MODEL=gpt-5.1

# BullMQ / Redis
REDIS_URL=redis://localhost:6379
OPENREVIEW_WORKER_CONCURRENCY=1
OPENREVIEW_JOB_ATTEMPTS=3
OPENREVIEW_JOB_BACKOFF_MS=30000

# Sealos DevBox
# Point this at a kubeconfig whose current context includes the target namespace and bearer token.
DEVBOX_KUBECONFIG_PATH=/path/to/devbox-kubeconfig.yaml
DEVBOX_JWT_SIGNING_KEY=your-devbox-jwt-signing-key
DEVBOX_JWT_TTL_SECONDS=14400
DEVBOX_ARCHIVE_AFTER_PAUSE_TIME=24h
DEVBOX_PAUSE_AFTER_MINUTES=300
DEVBOX_COMMAND_TIMEOUT_SECONDS=60

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret
